{
  "name": "food-menu-api",
  "version": "1.0.0",
  "description": "Express REST API for the food menu (ported from Next.js server actions)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "zod": "3.24.1",
    "prisma": "6.1.0"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  }
}
