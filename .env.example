NODE_ENV=development
PORT=5000

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/food_menu"

# JWT
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:5000

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Image storage for Vercel (read-only filesystem). Leave S3_BUCKET empty to use local disk.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
